// Inferir tipo de dato (público/privado/sensible) según nombre y tipo general
const inferTipoDato = (nombre, tipoGeneral) => {
  const base = (tipoGeneral || '').toLowerCase();
  const lower = (nombre || '').toLowerCase();

  // Palabras clave de datos sensibles
  const keywordsSensibles = [
    'salud', 'médic', 'medic', 'historia clini', 'incapacidad',
    'discapacidad', 'biometr', 'huella', 'rostro', 'facial',
    'video', 'fotograf', 'voz', 'imágenes', 
    'grupo sangu', 'etnia', 'orientación', 'religión',
    'antecedentes', 'procesos juridicos', 'procesos jurídicos', 'judiciales', 'datos biom','historias clíni'
  ];

  // Palabras clave de datos públicos típicos (registros, nombre, profesión, etc.)
  const keywordsPublicos = [
    'nombre', 'razón social', 'razon social',
    'registro civil', 'registros civiles', 'nacionalidad', 'fecha de nacimiento', 'estado civil', 'cedula', 'número de documento', 'documento de identificación',
    'tarjeta profesional', 'sexo', 'edad', 'género', 'número de identificación', 'tarjeta de identidad', 'Cédula de Extranjeria',
    'permiso de permanencia',
    'información registral', 'informe registral',
    'rut'
  ];

  // 1. Priorizar siempre lo SENSIBLE
  if (keywordsSensibles.some(k => lower.includes(k))) {
    return 'sensible';
  }

  // 2. Datos típicamente PÚBLICOS (según registros públicos)
  if (keywordsPublicos.some(k => lower.includes(k))) {
    return 'publico';
  }

  // 3. Si el tipo general declarado es público, todo público
  if (base.startsWith('publ')) return 'publico';

  // 4. Si el tipo general es sensible o privado, el resto va como privado
  if (base.startsWith('sens')) return 'privado';
  if (base.startsWith('priv')) return 'privado';

  // 5. Por defecto, privado (enfoque conservador)
  return 'privado';
};

// Construye arreglo de { nombre, tipo }
const construirDatos = (texto, tipoGeneral) =>
  splitComas(texto).map(nombre => ({
    nombre,
    tipo: inferTipoDato(nombre, tipoGeneral)
  }));

