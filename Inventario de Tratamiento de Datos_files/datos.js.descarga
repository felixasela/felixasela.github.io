// datos.js
// Helpers para normalizar texto del CSV
const splitComas = (txt = '') =>
  txt.replace(/\n/g, ',').split(',').map(t => t.trim()).filter(Boolean);

const splitGuionesYComas = (txt = '') =>
  txt.replace(/\n/g, ',').split(/,|-/).map(t => t.trim()).filter(Boolean);

